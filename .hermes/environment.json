{
  "name": "hermes-project-stewardship",
  "kind": "python-package",
  "bootstrap": [
    "uv venv .venv --allow-existing",
    "uv sync --locked --extra dev --extra plugin",
    "uv pip install --python .venv/bin/python pyyaml ruamel.yaml"
  ],
  "build": [
    "node hermes_dockyard_plugin/desktop/build.mjs",
    "git diff --exit-code -- hermes_dockyard_plugin/desktop/plugin.js desktop/plugin.js"
  ],
  "test": [
    ".venv/bin/python -m pytest",
    "node hermes_dockyard_plugin/desktop/run-browser-suite.mjs"
  ],
  "start": "sh -c 'STEWARD_DB_PATH=\"$(mktemp -d)/dockyard.db\" exec .venv/bin/python -m hermes_project_stewardship.api.server'",
  "port": 9310,
  "readinessPath": "/healthz"
}
